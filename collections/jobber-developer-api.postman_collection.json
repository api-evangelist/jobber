  "info": {
    "_postman_id": "5e653bc8-54e4-4185-a179-02ebf004407f",
    "name": "Jobber Developer API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Jobber Developer API is a GraphQL API for accessing and modifying data on Jobber accounts.\nA single HTTPS endpoint accepts POST requests containing GraphQL `query`, `variables`, and\n`operationName` fields. Authentication is OAuth 2.0 bearer access tokens. API versioning is\ndate-based and selected via the `X-JOBBER-GRAPHQL-VERSION` header. Rate limiting uses a\nleaky-bucket query-cost system in addition to a 2,500 requests per 5 minutes DDoS guard.\n\n\nContact Support:\n Name: Jobber API Support\n Email: api-support@getjobber.com",
      "type": "text/plain"
    }
  }
